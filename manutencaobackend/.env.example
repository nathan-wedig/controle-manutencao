# Copie este arquivo para .env e ajuste os valores.
# Valores default (usados quando a variável não é definida) estão documentados abaixo.

# Banco de dados (default: H2 em memória/arquivo local - ideal para demonstração)
APP_DATASOURCE_URL=jdbc:h2:file:./data/manutencao;AUTO_SERVER=TRUE
APP_DATASOURCE_USERNAME=sa
APP_DATASOURCE_PASSWORD=

# H2 console (manter desligado em produção)
APP_H2_CONSOLE_ENABLED=false

# JPA (ddl-auto=update ok para demonstração; usar validate/none em produção)
APP_JPA_DDL_AUTO=update
APP_JPA_SHOW_SQL=false

# Assinatura JWT - EM PRODUÇÃO, DEFINA SEMPRE um valor forte e secreto
JWT_SECRET=troque-esta-chave-por-um-valor-secreto-forte-de-pelo-menos-256-bits
JWT_EXPIRATION=86400000

# Senha do usuário admin criado no primeiro boot (DataInitializer)
APP_ADMIN_PASSWORD=admin123

# Pasta de upload de anexos
APP_UPLOAD_DIR=manutencaoanexos